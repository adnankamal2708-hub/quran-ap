// ═══════════════════════════════════════════════════════════════
// Firestore Security Rules — Bayan Quran Vocabulary App
//
// These rules secure the feedback and analytics_events collections
// that were added for the Beta Feedback & Analytics system.
//
// ── Collections ──────────────────────────────────────────────
//
//   feedback (collection)
//     Purpose: Stores user-submitted feedback (Profile → About → Send Feedback)
//     Type:    Public write, deny read
//     Fields:
//       text        (string, required, max 10,000 chars)
//       email       (string, nullable, max 320 chars)
//       timestamp   (number)
//       appVersion  (string, max 20 chars)
//       platform    (string, max 100 chars)
//       screenSize  (string, max 20 chars)
//       userAgent   (string, max 400 chars)
//       ts          (timestamp, Firestore server timestamp)
//
//   analytics_events (collection)
//     Purpose: Records anonymous milestone events for product analytics
//     Type:    Public write, deny read
//     Fields:
//       event       (string, required, max 100 chars)
//       data        (map, optional, max 8 fields)
//       timestamp   (timestamp)
//       appVersion  (string, max 20 chars)
//       platform    (string, max 100 chars)
//       screenSize  (string, max 20 chars)
//
// ── Security Model ───────────────────────────────────────────
//
// Both collections allow unauthenticated writes because feedback
// and analytics should not require an account. Abuse is mitigated
// through:
//   1. Field whitelisting (hasOnly) — prevents arbitrary field injection
//   2. Type validation — every field must match expected type
//   3. Size limits — prevents large document writes
//   4. Read denial — data is only accessible via Firebase Console
//   5. Rate limiting (recommended): deploy a Cloud Function for
//      production rate limiting — rules alone cannot rate-limit by IP.
//
// ── How to deploy ────────────────────────────────────────────
//
//   1. Install Firebase CLI: npm install -g firebase-tools
//   2. Login: firebase login
//   3. Init:  firebase init firestore (select project: bayan-quran-vocabulary)
//   4. This file will be at firestore.rules (the CLI creates it)
//   5. Deploy: firebase deploy --only firestore:rules
//
// ═══════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Feedback Collection ──────────────────────────────────
    //
    // Allows unauthenticated CREATE only. Each document must
    // contain only the whitelisted fields with correct types.
    // Deny read, update, and delete to the public.
    match /feedback/{docId} {

      // Validate ALL writes (create + update)
      function isValidFeedback() {
        let data = request.resource.data;

        // Whitelist allowed fields — reject any unknown field
        let allowed = data.keys().hasOnly([
          'text', 'email', 'timestamp', 'appVersion',
          'platform', 'screenSize', 'userAgent', 'ts'
        ]);

        let validText        = data.text is string
                            && data.text.size() > 0
                            && data.text.size() <= 10000;

        let validEmail       = data.email is string
                            && data.email.size() <= 320
                            || data.email is null;

        let validTimestamp   = data.timestamp is number;

        let validAppVersion  = data.appVersion is string
                            && data.appVersion.size() <= 20;

        let validPlatform    = data.platform is string
                            && data.platform.size() <= 100;

        let validScreenSize  = data.screenSize is string
                            && data.screenSize.size() <= 20;

        let validUserAgent   = data.userAgent is string
                            && data.userAgent.size() <= 400;

        let validTs      = data.ts is timestamp
                        || data.ts is null;

        return allowed
            && validText
            && validEmail
            && validTimestamp
            && validAppVersion
            && validPlatform
            && validScreenSize
            && validUserAgent
            && validTs
            && request.resource.size() < 10000;
      }

      // Only allow create with validation
      allow create: if isValidFeedback();

      // Deny reads, updates, and deletes to the public
      allow read, update, delete: if false;
    }

    // ── Analytics Events Collection ──────────────────────────
    //
    // Allows unauthenticated CREATE only for anonymous milestone
    // events. Field whitelisting prevents arbitrary data injection.
    match /analytics_events/{docId} {

      function isValidEvent() {
        let data = request.resource.data;

        let allowed = data.keys().hasOnly([
          'event', 'data', 'timestamp', 'appVersion',
          'platform', 'screenSize'
        ]);

        let validEvent       = data.event is string
                            && data.event.size() > 0
                            && data.event.size() <= 100;

        let validData        = data.data is map
                            && data.data.keys().size() <= 8;

        let validTimestamp   = data.timestamp is timestamp
                            || data.timestamp is number;

        let validAppVersion  = data.appVersion is string
                            && data.appVersion.size() <= 20;

        let validPlatform    = data.platform is string
                            && data.platform.size() <= 100;

        let validScreenSize  = data.screenSize is string
                            && data.screenSize.size() <= 20;

        return allowed
            && validEvent
            && validData
            && validTimestamp
            && validAppVersion
            && validPlatform
            && validScreenSize
            && request.resource.size() < 10000;
      }

      allow create: if isValidEvent();

      // Deny reads, updates, and deletes to the public
      allow read, update, delete: if false;
    }

    // ── Subscriptions Collection ────────────────────────────
    //
    // Stores Stripe subscription documents written by the webhook
    // (api/webhook.js uses Admin SDK — bypasses these rules).
    // Authenticated users can read their own subscription doc
    // so premium.js can check entitlement client-side.
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Webhook writes via Admin SDK (service account), not client.
      allow create, update, delete: if false;
    }

    // ── Learning Data Collection ─────────────────────────────
    match /learning/{docId} {
      allow read, write: if request.auth != null
                        && request.auth.uid == docId;
    }

    // ── User Profiles Collection ─────────────────────────────
    match /profiles/{docId} {
      allow read, write: if request.auth != null
                        && request.auth.uid == docId;
    }

    // ── Default Deny ─────────────────────────────────────────
    // Deny all other collections unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
